{
    "initializationAction": [
        "q.run_command('team join shops ' + q.player.username + '');"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username + '');",
        "q.dialogue.close();"
    ],
    "names": [
        "Celadon Department Clerk"
    ],
    "speakers": {
        "npc": {
            "name": "Celadon Department Clerk",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:shopman",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
               "Welcome to the Celadon Department Store! May I help you?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "Which TM would you like to purchase?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "TM Roar",
                        "value": "roar",
                        "action": "q.dialogue.set_page('pickroar');"
                    },
                    {
                        "text": "TM Hyper Beam",
                        "value": "hyperbeam",
                        "action": "q.dialogue.set_page('pickhyperbeam');"
                    },
                    {
                        "text": "TM Dig",
                        "value": "dig",
                        "action": "q.dialogue.set_page('pickdig');"
                    },
                    {
                        "text": "Page 2 >>",
                        "value": "page2",
                        "action": "q.dialogue.set_page('buy2');"
                    }
                ]
            }
        },
        {
            "id": "buy2",
            "speaker": "npc",
            "lines": [
                "Which TM would you like to purchase?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "TM Brick Break",
                        "value": "brickbreak",
                        "action": "q.dialogue.set_page('pickbrickbreak');"
                    },
                    {
                        "text": "TM Secret Power",
                        "value": "secretpower",
                        "action": "q.dialogue.set_page('picksecretpower');"
                    },
                    {
                        "text": "Tm Attract",
                        "value": "attract",
                        "action": "q.dialogue.set_page('pickattract');"
                    },
                    {
                        "text": "<< Page 1",
                        "value": "page1",
                        "action": "q.dialogue.set_page('buy1');"
                    }
                ]
            }
        },


        {
            "id": "pickroar",
            "speaker": "npc",
            "lines": [
                "$1000) The target is scared off, and a different Pokémon is dragged out. In the wild, this ends a battle against a single Pokémon."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 210');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickhyperbeam",
            "speaker": "npc",
            "lines": [
                "$7500) The target is attacked with a powerful beam. The user can't move on the next turn."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 211');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickdig",
            "speaker": "npc",
            "lines": [
                "$2000) The user burrows into the ground on the first turn, then attacks on the next turn."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 212');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickbrickbreak",
            "speaker": "npc",
            "lines": [
                "$3000) The user attacks with a swift chop. This move can also break barriers, such as Light Screen and Reflect."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 213');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "picksecretpower",
            "speaker": "npc",
            "lines": [
                "$3000) The additional effects of this attack depend upon where it was used."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 214');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickattract",
            "speaker": "npc",
            "lines": [
                "$3000) If the target is of the opposite gender to the user, it becomes infatuated with the user and will sometimes be unable to use its moves."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 215');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Back",
                        "value": "back",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "buyend",
            "speaker": "npc",
            "lines": [
                "Here you are! Thank you!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username + '');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },
        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                "Please come again!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username + '');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}