{
    "initializationAction": [
        "q.run_command('team join Coins ' + q.player.username + '');"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username + '');",
        "q.dialogue.close();"
    ],
    "names": [
        "Game Corner Clerk"
    ],
    "speakers": {
        "npc": {
            "name": "Game Corner Clerk",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:shopman",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
               "We exchange your Coins for TM prizes."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "Which prize would you like?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Ice Beam TM",
                        "value": "icebeam",
                        "action": "q.dialogue.set_page('pickicebeam');"
                    },
                    {
                        "text": "Iron Tail TM",
                        "value": "irontail",
                        "action": "q.dialogue.set_page('pickirontail');"
                    },
                    {
                        "text": "Thunderbolt TM",
                        "value": "thunderbolt",
                        "action": "q.dialogue.set_page('pickthunderbolt');"
                    },
                    {
                        "text": "Page 2 >>",
                        "value": "page2",
                        "action": "q.dialogue.set_page('buy2');"
                    }
                ]
            }
        },
        {
            "id": "buy2",
            "speaker": "npc",
            "lines": [
                "Which prize would you like?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Shadow Ball TM",
                        "value": "shadowball",
                        "action": "q.dialogue.set_page('pickshadowball');"
                    },
                    {
                        "text": "Flamethrower TM",
                        "value": "flamethrower",
                        "action": "q.dialogue.set_page('pickflamethrower');"
                    },
                    {
                        "text": "<< Page 1",
                        "value": "page1",
                        "action": "q.dialogue.set_page('buy1');"
                    }
                ]
            }
        },


        {
            "id": "pickicebeam",
            "speaker": "npc",
            "lines": [
                "4000 Coins) The target is struck with an icy-cold beam of energy. This may also leave the target frozen."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 216');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickirontail",
            "speaker": "npc",
            "lines": [
                "3500 Coins) The target is slammed with a steel-hard tail. This may also lower the target's Defense stat."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 217');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickthunderbolt",
            "speaker": "npc",
            "lines": [
                "4000 Coins) The user attacks the target with a strong electric blast. This may also leave the target with paralysis."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 218');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickshadowball",
            "speaker": "npc",
            "lines": [
                "4500 Coins) The user attacks by hurling a shadowy blob at the target. This may also lower the target's Sp. Def stat."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 219');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickflamethrower",
            "speaker": "npc",
            "lines": [
                "4000 Coins) The target is scorched with an intense blast of fire. This may also leave the target with a burn."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 220');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },


        {
            "id": "buyend",
            "speaker": "npc",
            "lines": [
                "Here you are! Thank you!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username + '');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },
        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                "Please come again!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('team join default ' + q.player.username + '');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}