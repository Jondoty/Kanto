{   
    "speakers": {
        "npc": {
          "name": "Warden",
          "face": {
            "type": "artificial",
            "modelType": "npc",
            "identifier": "cobblemon:oldman",
            "isLeftSide": false
          }
        },
        "player": {
         "face": "q.player.face(true);",
